# Copy to .env and fill in to enable real data. This build has NO mock
# data - without these vars set, the dashboard renders empty states
# ("No readings recorded yet", blank charts, Offline badge) and auth is
# disabled (every route stays open).
#
# SECURITY (closes G7): MQTT broker credentials are NOT in this file.
# The browser no longer connects to HiveMQ directly. The ingest-mqtt Edge
# Function is the sole MQTT subscriber and writer to sensor_readings; the
# browser gets live readings via Supabase Realtime. MQTT broker config
# lives only in the Edge Function's server-side secrets (see below).
#
# All vars here use the NEXT_PUBLIC_ prefix because they're safe for the
# browser (Supabase URL + anon key are public by design). Server-only
# secrets (service_role key, MQTT credentials) must NEVER use NEXT_PUBLIC_.

# --- Supabase (auth + persistence + Realtime backend) ---
# Project Settings > API in your Supabase project dashboard.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- REST API (optional, only if you add REST fetch calls) ---
NEXT_PUBLIC_API_BASE_URL=

# ===========================================================================
# SERVER-ONLY SECRETS — do NOT prefix these with NEXT_PUBLIC_
# Set these in Supabase Dashboard > Edge Functions > ingest-mqtt > Secrets
# ===========================================================================

# --- Edge Function: ingest-mqtt ---
# The sole MQTT subscriber + writer to sensor_readings.
# HiveMQ Cloud TCP MQTT URL (port 8883, TLS):
#   mqtts://<your-cluster-id>.s1.eu.hivemq.cloud:8883
MQTT_BROKER_URL=
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TOPIC=aether/sensors

# --- Supabase service_role key (Edge Function only, never in browser) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
